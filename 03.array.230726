#include<stdio.h>
int main(){
    int arr[100],n,i,pos,item;
   printf(" Enter number of elements");
   scanf("%d",&n);
   printf("enter array elements ");
   for(int i=0;i<n;i++){
    scanf("%d",&arr[i]);
   }
   printf("enter the pos");
   scanf("%d",&pos);
   for(int i=pos-1;i<n-1;i++){
    arr[i]=arr[i+1];

   }
   n--;


   for(int i=0;i<n;i++){
    printf("%d",arr[i]);
   }
   return 0;
}
