#include<stdio.h>
int main(){
    int arr[100],n,i,element,found;
    found=0;
   printf(" Enter number of elements");
   scanf("%d",&n);
   printf("enter array elements ");
   for(int i=0;i<n;i++){
    scanf("%d",&arr[i]);
   }
   printf("array elements are:\n");
   for(int i=0;i<n;i++){
    printf("%d",arr[i]);


   }
   printf("\nenter element:");
   scanf("%d",&element);
   for(int i=0;i<n;i++){
       if(arr[i]==element){
       found = 1;
       break;
    }
   }
   if (found == 1){
    printf("%d",i+1);
   }
   else{
    printf("not present");
   }
   return 0;
}
 
