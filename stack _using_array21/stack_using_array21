#include<stdio.h>
#define size 5;
int stack[5];
int top = -1;
void push (int x){
    if(top == 5 -1){
        printf("stack overflow");
    }
    else{
        top=top+1;
        stack[top]=x;
    }
}
    int pop(){
        if (top==-1){
            printf("stack underflow");
        }
        else {
            printf("deleted elemment is %d\n",stack[top]);
            top = top-1;
        }
    }
    void main (){
        push(10);
        push(20);
        push(30);
        pop();
        pop();
        push(15);
    }
    
