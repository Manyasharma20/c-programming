#include<stdio.h>
int main(){
    int arr[100],n,i,pos,item;
   printf(" Enter number of elements");
   scanf("%d",&n);
   printf("enter array elements ");
   for(int i=0;i<n;i++){
    scanf("%d",&arr[i]);
   }
   printf("enter pos");
   scanf("%d",&pos);
   for (int i=n;i>=pos;i--){
    arr[i]=arr[i-1];
  
   }
   arr[pos-1]=i;
   n++;

   for(int i=0;i<n;i++){
    printf("%d",arr[i]);
   }
   return 0;
}


